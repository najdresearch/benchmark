{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://najdresearch.com/contracts/v1/dataset-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "kind": {
      "const": "dataset_manifest"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "split": {
      "enum": [
        "development",
        "test"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": "string",
          "minLength": 1,
          "format": "uri"
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "method": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "url",
        "revision",
        "method"
      ]
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "license": {
          "type": "string",
          "minLength": 1
        },
        "evidence_url": {
          "type": "string",
          "minLength": 1,
          "format": "uri"
        }
      },
      "required": [
        "license",
        "evidence_url"
      ]
    },
    "cases": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+\\.jsonl$"
        },
        "sha256": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-f0-9]{64}$"
        },
        "count": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "path",
        "sha256",
        "count"
      ]
    },
    "case_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "created_at": {
      "type": "string",
      "minLength": 1,
      "format": "date-time"
    }
  },
  "required": [
    "schema_version",
    "kind",
    "id",
    "version",
    "description",
    "split",
    "source",
    "rights",
    "cases",
    "case_ids",
    "created_at"
  ]
}
