{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://najdresearch.com/contracts/v1/task-pack.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "kind": {
      "const": "task_pack"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "cases_sha256": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "id",
        "version",
        "cases_sha256"
      ]
    },
    "task_type": {
      "enum": [
        "classification",
        "text_generation",
        "tool_decision",
        "retrieval",
        "ocr",
        "speech"
      ]
    },
    "labels": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 2,
      "uniqueItems": true
    },
    "system_prompt": {
      "type": "string",
      "minLength": 1
    },
    "output_format": {
      "enum": [
        "json_label",
        "text",
        "tool_calls"
      ]
    },
    "harness": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "version"
      ]
    },
    "scorer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "metrics": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      },
      "required": [
        "id",
        "version",
        "metrics"
      ]
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32768
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600
        },
        "max_attempts": {
          "const": 1
        }
      },
      "required": [
        "max_tokens",
        "timeout_seconds",
        "max_attempts"
      ]
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "strategy": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "strategy",
        "description"
      ]
    },
    "uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "method": {
          "type": "string",
          "minLength": 1
        },
        "limitations": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "method",
        "limitations"
      ]
    },
    "stop_rules": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "kind",
    "id",
    "version",
    "description",
    "dataset",
    "task_type",
    "labels",
    "system_prompt",
    "output_format",
    "harness",
    "scorer",
    "budget",
    "baseline",
    "uncertainty",
    "stop_rules"
  ]
}
